# ========================================
# 前端环境变量配置示例
# 复制此文件为 .env 并根据环境修改
# ========================================

# 浏览器请求默认走同源网关；仅在跨域部署时填写公开 API 地址。
# 不需要带 /api/v1 后缀，代理会自动处理
VITE_API_BASE_URL=

# Vite 开发服务器在服务端使用的代理目标，不会暴露给浏览器。
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080
VITE_DEV_PORT=3000

# WebSocket URL（WS/WSS）
# 开发环境使用 ws://，生产环境使用 wss://
VITE_WS_URL=ws://localhost:8080

# 应用名称
VITE_APP_NAME=画师平台

# 是否开启调试日志
VITE_DEBUG=true
